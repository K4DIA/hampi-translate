@dataclass
class Protected:
    kind: str
    display: str
    spoken_en: str = ""
    freq: tuple = ()

    def spoken(self, lang):
        if self.kind == "freq":
            whole, frac, unit = self.freq
            word = DECIMAL_WORD.get(lang, "point")
            num = f"{whole} {word} {frac}" if frac else whole
            if lang == "ja":
                unit = "キロヘルツ" if unit == "kilohertz" else "メガヘルツ"
            return f"{num} {unit}"
        if lang == "ja":
            if self.kind in ("call", "grid"):
                return " ".join(JA_ITU.get(w, w) for w in self.spoken_en.split())
            if self.kind == "q":
                letters = " ".join(JA_LETTER[c] for c in self.display if c.isalpha())
                return letters + ("？" if self.display.endswith("?") else "")
        return self.spoken_en or self.display


def collapse_spelled_calls(text):
    """'kilo four delta india alfa' -> 'K4DIA' (Whisper often writes calls out)."""
    toks = list(re.finditer(r"[A-Za-z]+(?:-[A-Za-z]+)?|\d|/", text))

    words = set()                   # tokens that were phonetic words ("kilo")

    def sym(m):
        w = m.group(0).lower()
        if w in SPOKEN_LETTER:
            words.add(m.start())
            return SPOKEN_LETTER[w]
        if w in SPOKEN_DIGIT:
            return SPOKEN_DIGIT[w]
        if w in ("stroke", "slash", "/"):
            return "/"
        if len(w) == 1 and w.isalnum():
            return w.upper()
        return None

    def plausible(part):
        """All the letters are phonetic words, or all are single characters.
        A mix ("Mike, 1 a day", "November 2 I went") is ordinary speech."""
        letters = [m.start() in words for m, sy in part if sy.isalpha()]
        return bool(letters) and (all(letters) or not any(letters))

    runs, cur = [], []
    for m in toks:
        s = sym(m)
        joined = cur and re.fullmatch(r"[\s,-]*", text[cur[-1][0].end():m.start()])
        if s is not None and (not cur or joined):
            cur.append((m, s))
            continue
        if cur:
            runs.append(cur)
        cur = [(m, s)] if s is not None else []
    if cur:
        runs.append(cur)

    repl = []
    for run in runs:
        i = 0
        while i < len(run):
            for j in range(len(run), i + 2, -1):            # at least 3 symbols
                cand = "".join(s for _, s in run[i:j])
                if (CALL_RE.fullmatch(cand) and cand not in NOT_CALLS
                        and plausible(run[i:j])):
                    repl.append((run[i][0].start(), run[j - 1][0].end(), cand))
                    i = j
                    break
            else:
                i += 1
    for a, b, cand in reversed(repl):
        text = text[:a] + cand + text[b:]
    return text


def _word_digit(w):
    return SPOKEN_DIGIT.get(w.lower(), w)


def protect(text, glossary=()):
    """Swap ham jargon for placeholders. Returns (masked_text, [Protected])."""
    items = []

    def add(item):
        items.append(item)
        return f" {PH_FMT.format(len(items) - 1)} "

    text = collapse_spelled_calls(text)
    for term in sorted(glossary, key=len, reverse=True):
        text = re.sub(rf"(?<![\w]){re.escape(term)}(?![\w])",
                      lambda m: add(Protected("term", m.group(0))), text, flags=re.I)

    def call(m):
        c = m.group(1).upper()
        if c in NOT_CALLS:
            return m.group(0)
        return add(Protected("call", c, phonetic(c)))
    text = CALL_RE.sub(call, text)

    def grid(m):
        g = m.group(1)
        if len(g) == 4 and not GRID_CONTEXT_RE.search(m.string[:m.start()]):
            return m.group(0)
        g = g[:4].upper() + g[4:].lower()
        spoken = " ".join(ITU_LETTERS[c.upper()] if c.isalpha() else c for c in g)
        return add(Protected("grid", g, spoken))
    text = GRID_RE.sub(grid, text)

    def rst(m):
        digits = [_word_digit(g) for g in m.groups() if g]
        return add(Protected("rst", " ".join(digits)))
    def rst_cued(m):
        if not RST_CONTEXT_RE.search(m.string[:m.start()]):
            return m.group(0)
        return rst(m)

    def rst_by(m):
        return rst(m) if m.group(1).lower() in ("5", "five") else rst_cued(m)
    text = RST_BY_RE.sub(rst_by, text)
    text = RST_PAIR_RE.sub(rst, text)
    text = RST_COMPACT_RE.sub(rst_cued, text)

    def qcode(m):
        q = m.group(1).upper() + (m.group(2) or "")
        return add(Protected("q", q, spell(m.group(1)) + (m.group(2) or "")))
    text = Q_RE.sub(qcode, text)

    def freq(m):
        num, unit = m.group(1), m.group(2).lower()
        unit = "kilohertz" if unit.startswith("k") else "megahertz"
        if unit == "kilohertz" and re.fullmatch(r"\d{1,3},\d{3}(?:\.\d+)?", num):
            num = num.replace(",", "")          # 7,150 kHz: a thousands comma
        num = num.replace(",", ".")             # 14,250 MHz: a decimal comma
        if not re.fullmatch(r"\d{1,5}(?:\.\d{1,4})?", num):
            return m.group(0)
        whole, _, frac = num.partition(".")
        shown = f"{whole}.{frac}" if frac else whole
        disp = f"{shown} {'kHz' if unit == 'kilohertz' else 'MHz'}"
        return add(Protected("freq", disp, freq=(whole, frac, unit)))
    text = FREQ_RE.sub(freq, text)

    text = GREETING_RE.sub(lambda m: add(Protected("greeting", m.group(1))), text)
    return re.sub(r"\s{2,}", " ", text).strip(), items


def restore(translated, items, lang):
    """Put the jargon back. Returns (display, spoken), or None if the
    translator dropped or duplicated a placeholder."""
    found = [int(m.group(1)) for m in PH_RE.finditer(translated)]
    if sorted(found) != list(range(len(items))):
        return None

    def sub(form):
        def f(m):
            it = items[int(m.group(1))]
            return it.display if form == "display" else it.spoken(lang)
        return tidy(PH_RE.sub(f, translated))
    return sub("display"), sub("spoken")


def tidy(text):
    """Collapse the spaces placeholders leave behind, including before punctuation."""
    text = re.sub(r"\s+([,.!?;:])", r"\1", text)
    return re.sub(r"\s{2,}", " ", text).strip()


def load_glossary(path):
    """One do-not-translate term per line (names, rig models, places)."""
    terms = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.split("#", 1)[0].strip()
                if line:
                    terms.append(line)
    except OSError:
        pass
    return terms


@dataclass
class Translation:
    source: str
    display: str        # what the screen shows
    spoken: str         # what the voice says (callsigns as phonetics, etc.)
    fallback: bool = False


class PhraseTranslator:
    """Jargon-safe wrapper around any `backend(text, src, dst) -> str`."""

    def __init__(self, backend, glossary=()):
        self.backend = backend
        self.glossary = list(glossary)

    def translate(self, text, src, dst):
        text = text.strip()
        masked, items = protect(text, self.glossary)
        if src == dst:
            out = restore(masked, items, dst)
            return Translation(text, *out)
        if not items:
            out = self.backend(masked, src, dst).strip()
            return Translation(text, out, out)
        out = restore(self.backend(masked, src, dst), items, dst)
        if out is not None:
            return Translation(text, *out)
        # The model mangled a placeholder: translate the plain-language runs
        # between the jargon one by one and splice the jargon back in order.
        disp, spk = [], []
        for part in re.split(r"(ZXQ\d+)", masked):
            m = re.fullmatch(r"ZXQ(\d+)", part)
            if m:
                it = items[int(m.group(1))]
                disp.append(it.display)
                spk.append(it.spoken(dst))
            elif re.search(r"\w", part):
                t = self.backend(part.strip(), src, dst).strip()
                disp.append(t)
                spk.append(t)
            elif part.strip():
                disp.append(part.strip())
                spk.append(part.strip())
        return Translation(text, tidy(" ".join(disp)), tidy(" ".join(spk)), fallback=True)


ARGOS_DIR = SHARE + "/argos"          # Argos Translate language packs, unzipped
ARGOS_INDEX = "https://raw.githubusercontent.com/argosopentech/argospm-index/main/index.json"


def find_packs(root=ARGOS_DIR):
    """{(from, to): (pack_dir, metadata)} for every unzipped Argos pack."""
    packs = {}
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return packs
    for name in names:
        try:
            with open(os.path.join(root, name, "metadata.json"), encoding="utf-8") as fh:
                meta = json.load(fh)
            packs[(meta["from_code"], meta["to_code"])] = (os.path.join(root, name), meta)
        except (OSError, ValueError, KeyError):
            continue
    return packs


def split_sentences(text):
    """Radio overs are a few short sentences; a full NLP splitter isn't needed.
    Also splits after 。！？ (Chinese, Japanese), । (Hindi) and ؟ (Arabic, Persian)."""
    parts = re.split(r"(?<=[.!?])\s+|(?<=[。！？।؟])\s*", text.strip())
    return [p.strip() for p in parts if p and p.strip()]


class PackBackend:
    """Runs Argos Translate language packs (OPUS-MT models) directly on
    CTranslate2 + SentencePiece, in-process and loaded once.

    The argostranslate library itself is deliberately not used: it imports
    stanza and with it PyTorch at start-up (hundreds of MB and many seconds
    on a Pi 4) for sentence splitting this tool doesn't need."""

    def __init__(self, root=ARGOS_DIR, beam=2, threads=4):
        self.root, self.beam, self.threads = root, int(beam), int(threads)
        self._loaded = {}

    def _load(self, src, dst):
        pack = find_packs(self.root).get((src, dst))
        if pack is None:
            raise RuntimeError(f"No translation pack for {src}->{dst} in {self.root}. "
                               f"Run: sudo rfpi-translator-install --langs "
                               f"{dst if src == 'en' else src}")
        path, meta = pack
        sp_model = os.path.join(path, "sentencepiece.model")
        if not os.path.exists(sp_model):
            raise RuntimeError(f"{path} uses a BPE tokenizer; pick a SentencePiece pack.")
        import ctranslate2
        import sentencepiece
        translator = ctranslate2.Translator(os.path.join(path, "model"), device="cpu",
                                            compute_type="int8", inter_threads=1,
                                            intra_threads=self.threads)
        return translator, sentencepiece.SentencePieceProcessor(model_file=sp_model), \
            meta.get("target_prefix", "")

    def __call__(self, text, src, dst):
        key = (src, dst)
        if key not in self._loaded:
            self._loaded[key] = self._load(src, dst)
        translator, sp, prefix = self._loaded[key]
        sentences = split_sentences(text)
        if not sentences:
            return ""
        tokens = [sp.encode(s, out_type=str) for s in sentences]
        results = translator.translate_batch(
            tokens, target_prefix=[[prefix]] * len(tokens) if prefix else None,
            beam_size=self.beam, num_hypotheses=1, length_penalty=0.2,
            replace_unknowns=True,
            # A translation is about as long as its source; cap runaway loops.
            max_decoding_length=min(256, 2 * max(len(t) for t in tokens) + 16))
        out = []
        for r in results:
            v = sp.decode_pieces(r.hypotheses[0]).replace("\u2581", " ").strip()
            if prefix and v.startswith(prefix):
                v = v[len(prefix):].strip()
            out.append(v)
        return " ".join(out)


def _version(v):
    return tuple(int(x) for x in re.findall(r"\d+", str(v)))


def fetch_packs(mine, others, root=ARGOS_DIR, index_url=ARGOS_INDEX):
    """Download and unzip the Argos packs for mine<->each other language.
    The only part of the translator that needs internet."""
    import shutil
    import urllib.request
    import zipfile
    with urllib.request.urlopen(index_url, timeout=60) as resp:
        index = json.loads(resp.read().decode("utf-8"))
    os.makedirs(root, exist_ok=True)
    missing = []
    for other in others:
        for a, b in ((mine, other), (other, mine)):
            entries = [e for e in index if e.get("from_code") == a and e.get("to_code") == b]
            if not entries:
                missing.append(f"{a}->{b}")
                continue
            e = max(entries, key=lambda x: _version(x.get("package_version", "0")))
            url = next((l for l in e.get("links", []) if l.startswith("http")), None)
            if url is None:
                missing.append(f"{a}->{b}")
                continue
            print(f"  {a}->{b}  {e.get('package_version')}  {url}")
            with tempfile.TemporaryDirectory() as d:
                zpath = os.path.join(d, "pack.zip")
                with urllib.request.urlopen(url, timeout=600) as resp, open(zpath, "wb") as fh:
                    shutil.copyfileobj(resp, fh)
                with zipfile.ZipFile(zpath) as z:
                    top = {n.split("/", 1)[0] for n in z.namelist()}
                    if len(top) != 1 or any(n.startswith("/") or ".." in n.split("/")
                                            for n in z.namelist()):
                        raise RuntimeError(f"unexpected layout in {url}")
                    dest = os.path.join(root, top.pop())
                    shutil.rmtree(dest, ignore_errors=True)
                    z.extractall(root)
            readme = os.path.join(dest, "README.md")
            if os.path.exists(readme):
                print(f"     training data and license: {readme}")
    if missing:
        raise RuntimeError("No Argos pack for: " + ", ".join(missing))


def run_tool(cmd, **kw):
    """subprocess.run that reports the program's own error text on failure."""
    try:
        return subprocess.run(cmd, check=True, capture_output=True, **kw)
    except FileNotFoundError as exc:
        raise RuntimeError(f"{cmd[0]} is not installed ({exc}). "
                           "Run: sudo rfpi-translator-install") from exc
    except subprocess.CalledProcessError as exc:
        err = (exc.stderr or b"").decode("utf-8", "replace").strip()[-400:]
        raise RuntimeError(f"{os.path.basename(str(cmd[0]))} failed "
                           f"(exit {exc.returncode}): {err or 'no error output'}") from exc


def clean_transcript(text):
    """Drop Whisper's non-speech tags and known noise hallucinations."""
    text = re.sub(r"\[[^\]]*\]|\([^)]*\)|\*[^*]*\*", " ", text or "")
    text = re.sub(r"\s+", " ", text).strip()
    low = text.lower()
    if any(h in low for h in HALLUCINATIONS) or not re.search(r"\w", text):
        return ""
    return text


# ---------------------------------------------------------------------------
# Audio helpers (numpy only; 16 kHz mono float32 is the internal format)
# ---------------------------------------------------------------------------

STT_RATE = 16000


def _np():
    import numpy
    return numpy


def to_mono(x):
    np = _np()
    x = np.asarray(x, dtype=np.float32)
    return x.mean(axis=1) if x.ndim == 2 else x


def resample(x, src, dst):
    """Windowed-sinc low-pass (when downsampling) + linear interpolation.
    Plenty for 300-3000 Hz voice; avoids a scipy dependency."""
    np = _np()
    x = to_mono(x)
    if src == dst or len(x) == 0:
        return x
    if dst < src and len(x) >= 97:      # shorter than the filter: nothing worth filtering
        cutoff = 0.45 * dst / src
        n = np.arange(-48, 49)
        h = 2 * cutoff * np.sinc(2 * cutoff * n) * np.hamming(len(n))
        x = np.convolve(x, (h / h.sum()).astype(np.float32), mode="same")
    t_out = np.arange(int(len(x) * dst / src)) * (src / dst)
    return np.interp(t_out, np.arange(len(x)), x).astype(np.float32)


def rms_db(x):
    np = _np()
    if len(x) == 0:
        return -120.0
    r = float(np.sqrt(np.mean(np.square(x, dtype=np.float64))))
    return 20 * np.log10(r) if r > 1e-6 else -120.0


def read_wav(path_or_bytes):
    np = _np()
    src = io.BytesIO(path_or_bytes) if isinstance(path_or_bytes, bytes) else path_or_bytes
    with wave.open(src, "rb") as w:
        rate, ch, width = w.getframerate(), w.getnchannels(), w.getsampwidth()
        raw = w.readframes(w.getnframes())
    if width == 2:
        x = np.frombuffer(raw, dtype="<i2").astype(np.float32) / 32768.0
    elif width == 1:
        x = (np.frombuffer(raw, dtype=np.uint8).astype(np.float32) - 128) / 128.0
    elif width == 4:
        x = np.frombuffer(raw, dtype="<i4").astype(np.float32) / 2147483648.0
    else:
        raise ValueError(f"unsupported WAV sample width {width}")
    if ch > 1:
        x = x.reshape(-1, ch).mean(axis=1)
    return x, rate


def wav_bytes(x, rate):
    np = _np()
    pcm = (np.clip(to_mono(x), -1, 1) * 32767).astype("<i2").tobytes()
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(int(rate))
        w.writeframes(pcm)
    return buf.getvalue()


def write_wav(path, x, rate):
    with open(path, "wb") as fh:
        fh.write(wav_bytes(x, rate))


def join_audio(parts, rate, gap_ms=250):
    np = _np()
    gap = np.zeros(int(rate * gap_ms / 1000), dtype=np.float32)
    out = []
    for p in parts:
        if p is not None and len(p):
            if out:
                out.append(gap)
            out.append(to_mono(p))
    return np.concatenate(out) if out else np.zeros(0, dtype=np.float32)


class Segmenter:
    """Cuts a continuous receive stream into transmissions: audio above the
    threshold opens a segment, RX_HANG_MS of quiet closes it."""

    def __init__(self, rate, threshold_db=-38.0, hang_ms=900, min_ms=700,
                 max_s=90, preroll_ms=250):
        self.rate = rate
        self.thr = threshold_db
        self.hang = int(rate * hang_ms / 1000)
        self.min = int(rate * min_ms / 1000)
        self.max = int(rate * max_s)
        self.pre = int(rate * preroll_ms / 1000)
        self.reset()

    def reset(self):
        self.buf, self.n, self.quiet, self.active = [], 0, 0, False
        self.ring, self.ring_n = [], 0

    def feed(self, block):
        """Feed a block of samples; returns a list of finished segments."""
        np = _np()
        block = to_mono(block)
        loud = rms_db(block) > self.thr
        done = []
        if not self.active:
            self.ring.append(block)
            self.ring_n += len(block)
            while self.ring and self.ring_n - len(self.ring[0]) >= self.pre:
                self.ring_n -= len(self.ring.pop(0))
            if loud:
                self.active, self.buf, self.n, self.quiet = True, list(self.ring), self.ring_n, 0
                self.ring, self.ring_n = [], 0
            return done
        self.buf.append(block)
        self.n += len(block)
        self.quiet = 0 if loud else self.quiet + len(block)
        if self.quiet >= self.hang or self.n >= self.max:
            seg = np.concatenate(self.buf)
            if self.quiet >= self.hang:
                seg = seg[:max(0, len(seg) - self.quiet + self.hang // 4)]
            if len(seg) - self.pre >= self.min:
                done.append(seg)
            self.active, self.buf, self.n, self.quiet = False, [], 0, 0
        return done


