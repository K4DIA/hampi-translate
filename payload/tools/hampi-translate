ITU_LETTERS = {
    "A": "Alfa", "B": "Bravo", "C": "Charlie", "D": "Delta", "E": "Echo",
    "F": "Foxtrot", "G": "Golf", "H": "Hotel", "I": "India", "J": "Juliett",
    "K": "Kilo", "L": "Lima", "M": "Mike", "N": "November", "O": "Oscar",
    "P": "Papa", "Q": "Quebec", "R": "Romeo", "S": "Sierra", "T": "Tango",
    "U": "Uniform", "V": "Victor", "W": "Whiskey", "X": "X-ray", "Y": "Yankee",
    "Z": "Zulu",
}
SPOKEN_LETTER = {v.lower(): k for k, v in ITU_LETTERS.items()}
SPOKEN_LETTER.update({"alpha": "A", "juliet": "J", "whisky": "W", "xray": "X"})
SPOKEN_DIGIT = {"zero": "0", "one": "1", "two": "2", "three": "3", "four": "4",
                "five": "5", "six": "6", "seven": "7", "eight": "8", "nine": "9",
                "niner": "9"}
_RD = r"(?:[1-5]|one|two|three|four|five)"            # readability 1-5
_SD = r"(?:[1-9]|one|two|three|four|five|six|seven|eight|nine|niner)"  # strength 1-9

# Optional "DL/" style prefix, the call, optional "/P" style suffix.
CALL_RE = re.compile(
    r"(?<![A-Za-z0-9/])((?:[A-Za-z0-9]{1,4}/)?"
    r"(?:[A-Za-z]{1,2}|[A-Za-z][0-9]|[0-9][A-Za-z])[0-9][A-Za-z]{1,4}"
    r"(?:/[A-Za-z0-9]{1,4})?)(?![A-Za-z0-9/])")
NOT_CALLS = {"H2O", "B2B", "B2C", "Y2K", "P2P", "W3C"}     # callsign-shaped ordinary words
GRID_RE = re.compile(r"(?<![A-Za-z0-9])([A-Ra-r]{2}[0-9]{2}(?:[A-Xa-x]{2})?)(?![A-Za-z0-9])")
# A 4-character grid (FN42) looks like many other tokens, so it needs a cue.
GRID_CONTEXT_RE = re.compile(r"\b(?:grid|locator|locatore|square|maidenhead)\b[\w\s,']{0,20}$",
                             re.I)
# Words after a number that mean it is a quantity, not a signal report.
_NOT_RST = (r"(?!\s*(?:-|\b(?:watts?|w|elements?|el|met(?:er|re)s?|m|feet|foot|ft|miles?|km|"
            r"years?|months?|days?|hours?|minutes?|seconds?|contacts?|qsos?|stations?|countries|"
            r"amps?|volts?|dollars?|euros?|percent|degrees?|o'?clock|a\.?m|p\.?m|mhz|khz|hz|"
            r"zero|one|two|three|four|five|six|seven|eight|nine|niner|\d)\b))")
_NOT_AFTER_NUM = (r"(?<!\b(?:zero|four|five|nine)\s)(?<!\b(?:one|two|six)\s)"
                  r"(?<!\b(?:three|seven|eight|niner)\s)(?<!\d\s)(?<![\w.])")
# "five by nine": readability 5 stands alone; "four by seven" needs a report cue
RST_BY_RE = re.compile(rf"{_NOT_AFTER_NUM}({_RD})\s+by\s+({_SD})(?![\w]){_NOT_RST}", re.I)
# "five nine", "5 9": readability 5 only, so ordinary pairs ("two three") are left alone
RST_PAIR_RE = re.compile(rf"{_NOT_AFTER_NUM}(5|five)\s+({_SD})(?![\w]){_NOT_RST}", re.I)
# "59", "599", "5/9": only next to report words, so "I'm 59" stays a number
RST_COMPACT_RE = re.compile(rf"(?<![\w.:/-])([345])/?([1-9])([1-9])?(?![\w.:/]){_NOT_RST}")
RST_CONTEXT_RE = re.compile(
    r"\b(?:report|signal|signals|rst|you'?re|you are|you|copy|copying|giving|solid|"
    r"rapporto|segnale|sei|reporte|señal|rapport)\b[\w\s,']{0,12}$", re.I)
Q_CODES = ("QRA QRG QRK QRL QRM QRN QRO QRP QRQ QRS QRT QRU QRV QRX QRZ QSB QSD QSK "
           "QSL QSO QSP QSX QSY QTC QTH QTR CQ").split()
Q_RE = re.compile(r"(?<![A-Za-z0-9])(" + "|".join(Q_CODES) + r")(\?)?(?![A-Za-z0-9])", re.I)
FREQ_RE = re.compile(
    r"(?<![\w.,])(\d[\d.,]{0,10}\d|\d)\s*(mhz|khz|megahertz|kilohertz|megs?)\b", re.I)
GREETING_RE = re.compile(r"(?<![\w.])(73|88)s?(?![\w.])")

# A placeholder Argos copies through untouched (it reads like an acronym).
PH_FMT = "ZXQ{}"
PH_RE = re.compile(r"Z\s?X\s?Q\s?(\d+)", re.I)


def phonetic(call):
    """K4DIA -> 'Kilo 4 Delta India Alfa'; '/' -> 'stroke'."""
    out = []
    for ch in call.upper():
        if ch.isalpha():
            out.append(ITU_LETTERS[ch])
        elif ch.isdigit():
            out.append(ch)
        elif ch == "/":
            out.append("stroke")
    return " ".join(out)


def spell(s):
    """'QTH' -> 'Q T H' so a TTS voice says the letters, in its own language."""
    return " ".join(s.upper())


