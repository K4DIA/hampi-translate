class KeyboardLocal:
    """Enter starts talking, Enter again stops. Commands: i = send ID /
    end contact, q = quit. Works over SSH and in the kiosk terminal."""

    def __init__(self):
        self.lines = queue.Queue()
        self.eof = False
        self._talking = False
        self._released = threading.Event()
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self):
        for line in sys.stdin:
            self.lines.put(line.strip().lower())
        self.eof = True
        self.lines.put("q")

    def wait_press(self):
        print("\n[Enter] talk   [i Enter] send ID / end contact   [q Enter] quit")
        cmd = self.lines.get()
        if cmd in ("q", "quit", "exit"):
            return "quit"
        if cmd in ("i", "id"):
            return "id"
        self._released.clear()
        self._talking = True
        print("● Talking... press Enter when done.")

        def wait_release():
            line = self.lines.get()
            if self._talking:
                self._released.set()
            else:                       # recording already ended (time limit):
                self.lines.put(line)    # this Enter belongs to the next prompt
        threading.Thread(target=wait_release, daemon=True).start()
        return "talk"

    def is_down(self):
        return not self._released.is_set()

    def end_talk(self):
        self._talking = False

    def confirm(self, timeout, what="Send it?"):
        """True only for a deliberate yes typed AFTER the prompt appears:
        Enter, y or yes. Anything else, or no answer in time, is a no."""
        while True:                     # keys pressed before the prompt don't count
            try:
                self.lines.get_nowait()
            except queue.Empty:
                break
        if self.eof:
            return False
        print(f"{what} [Enter] transmit   [n Enter] discard   ({int(timeout)} s)")
        try:
            ans = self.lines.get(timeout=timeout)
        except queue.Empty:
            return False
        return ans in ("", "y", "yes") and not self.eof


class GpioLocal:
    """Footswitch / button to GND on LOCAL_PTT_GPIO: hold to talk. In review
    a short tap sends, a hold of 1.5 s or more discards."""

    def __init__(self, pin, id_pin=""):
        from gpiozero import Button
        self.btn = Button(int(pin), pull_up=True, bounce_time=0.03)
        self.id_btn = Button(int(id_pin), pull_up=True, bounce_time=0.03) if id_pin else None
        self._id = threading.Event()
        if self.id_btn:
            self.id_btn.when_pressed = self._id.set

    def wait_press(self):
        print("\n(hold the footswitch to talk)")
        self._id.clear()                # an ID press made mid-over doesn't key later
        while True:
            if self._id.is_set():
                self._id.clear()
                return "id"
            if self.btn.wait_for_press(timeout=0.2):
                print("● Talking...")
                return "talk"

    def is_down(self):
        return self.btn.is_pressed

    def end_talk(self):
        pass

    def confirm(self, timeout, what="Send it?"):
        # Still held from the recording? That press must not count as "send".
        if self.btn.is_pressed and not self.btn.wait_for_release(timeout=timeout):
            return False
        print(f"{what} Tap the footswitch to transmit, hold 1.5 s to discard "
              f"({int(timeout)} s).")
        if not self.btn.wait_for_press(timeout=timeout):
            return False
        t0 = time.monotonic()
        self.btn.wait_for_release(timeout=5)
        return time.monotonic() - t0 < 1.5


def make_local(conf):
    if conf["LOCAL_PTT"].lower() == "gpio":
        return GpioLocal(conf["LOCAL_PTT_GPIO"], conf.get("ID_GPIO", ""))
    return KeyboardLocal()


# ---------------------------------------------------------------------------
# Sound devices (sounddevice / PortAudio)
# ---------------------------------------------------------------------------

def _sd():
    try:
        import sounddevice
    except (ImportError, OSError) as exc:
        sys.exit(f"sounddevice/PortAudio not available ({exc}). Run: sudo rfpi-translator-install")
    return sounddevice


def find_device(spec, kind):
    """'default', an index, or a case-insensitive name substring."""
    sd = _sd()
    if spec in ("", "default"):
        return None
    if str(spec).isdigit():
        return int(spec)
    want = "max_input_channels" if kind == "input" else "max_output_channels"
    for i, d in enumerate(sd.query_devices()):
        if spec.lower() in d["name"].lower() and d[want] > 0:
            return i
    raise RuntimeError(f"No {kind} audio device matching '{spec}'. See: hampi-translate devices")


def device_rate(dev, kind):
    sd = _sd()
    return int(sd.query_devices(dev, kind)["default_samplerate"])


def record_while(dev, is_down, max_s):
    sd = _sd()
    np = _np()
    rate = device_rate(dev, "input")
    chunks = []
    with sd.InputStream(device=dev, channels=1, samplerate=rate, dtype="float32",
                        callback=lambda data, *_: chunks.append(data.copy())):
        t0 = time.monotonic()
        while is_down() and time.monotonic() - t0 < max_s:
            time.sleep(0.02)
        if time.monotonic() - t0 >= max_s:
            print(f"(recording stopped at the {max_s:.0f} s limit)")
    audio = np.concatenate(chunks)[:, 0] if chunks else np.zeros(0, dtype=np.float32)
    return resample(audio, rate, STT_RATE)


def play(audio, rate, dev, gain=1.0, stop=None):
    """Play and wait. Each call opens its own stream: sounddevice's shared
    sd.play() stops whatever another thread is playing, which would let a
    receive playback cut off a transmission. `stop` (an Event) ends it early."""
    sd = _sd()
    np = _np()
    out_rate = device_rate(dev, "output")
    x = np.ascontiguousarray((resample(audio, rate, out_rate) * float(gain))
                             .astype(np.float32).reshape(-1, 1))
    block = max(1, out_rate // 10)
    with sd.OutputStream(device=dev, channels=1, samplerate=out_rate, dtype="float32") as out:
        for i in range(0, len(x), block):
            if stop is not None and stop.is_set():
                out.abort()
                return
            out.write(x[i:i + block])
        out.stop()                      # waits until the last buffer has played


