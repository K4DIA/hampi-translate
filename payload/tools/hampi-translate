def load_kv(path, base=None):
    """KEY=VALUE config, same format as the other /etc/hampi/*.conf files."""
    conf = dict(base or {})
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if "=" not in line or line.startswith("#"):
                    continue
                k, v = line.split("=", 1)
                k, v = k.strip(), v.strip()
                if k.startswith("export "):
                    k = k[7:].strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                    v = v[1:-1]                     # quoted: taken verbatim
                else:
                    # A trailing comment needs two spaces or a tab before the
                    # "#", so a device name like "USB Audio #2" survives.
                    v = re.split(r"(?:\s{2,}|\t)#", v, maxsplit=1)[0].strip()
                conf[k] = v
    except OSError:
        pass
    return conf


def load_conf(path=None):
    conf = load_kv(path or CONF_PATH, DEFAULTS)
    station = load_kv(STATION_CONF)
    conf["CALLSIGN"] = station.get("CALLSIGN", "N0CALL").upper()
    return conf


def flag(conf, key):
