        line(True, "CTranslate2 + SentencePiece")
    except ImportError:
        line(False, "CTranslate2 + SentencePiece", "-> sudo rfpi-translator-install")
    packs = find_packs(conf.get("ARGOS_DIR", ARGOS_DIR))
    for a, b in ((conf["MY_LANG"], conf["THEIR_LANG"]), (conf["THEIR_LANG"], conf["MY_LANG"])):
        pack = packs.get((a, b))
        line(pack is not None, f"Translation pack {a}->{b}",
             pack[0] if pack else f"installed: {sorted(packs) or 'none'} "
             f"-> sudo rfpi-translator-install --langs {conf['THEIR_LANG']}")
    line(os.path.exists(conf["PIPER"]), "Piper", conf["PIPER"])
    for lang in sorted({conf["MY_LANG"], conf["THEIR_LANG"], "en"}):
        v = voice_for(conf, lang)
        path = v[len(OPENJTALK):] if v.startswith(OPENJTALK) else v
        line(bool(v) and os.path.exists(path), f"Voice {lang}", v or f"set VOICE_{lang.upper()}")
        if v.startswith(OPENJTALK):
            line(os.path.isdir(conf["OPENJTALK_DIC"]), "Open JTalk dictionary", conf["OPENJTALK_DIC"])
    unknown = sorted({conf["MY_LANG"], conf["THEIR_LANG"]} - set(LANGUAGES))
    if unknown:
        print(f"  [--] Not a tested language: {', '.join(unknown)} (no spoken disclosure; "
              f"see TRANSLATOR.md for the supported list)")
    for key, kind in (("OPERATOR_IN", "input"), ("OPERATOR_OUT", "output"),
                      ("RADIO_IN", "input"), ("RADIO_OUT", "output")):
        try:
            find_device(conf[key], kind)
            line(True, f"Audio {key}", conf[key])
        except (RuntimeError, SystemExit) as exc:
            line(False, f"Audio {key}", str(exc))
    if conf["PTT"].lower() == "rigctld":
        try:
            st = RigctldPTT(conf["RIGCTLD"]).status().strip()
            line(st in ("0", "1"), "rigctld PTT", f"{conf['RIGCTLD']} (PTT state {st})" + (
                "" if st in ("0", "1") else
                " -> rigctld can't key this rig: start it with -P RIG (CAT PTT) "
                "or -P RTS -p /dev/ttyUSB0"))
        except OSError as exc:
            line(False, "rigctld PTT", f"{exc} -> start it: rigctld -m <model> -r /dev/ttyUSB0 -P RIG &")
    else:
        line(True, "PTT", conf["PTT"])
    print("\nAll set." if ok else "\nFix the !! lines, then run: hampi-translate check")
    return 0 if ok else 1


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    # Models and Python deps live in their own venv; re-run inside it.
    if (os.path.exists(VENV_PY) and not os.environ.get("HAMPI_TRANSLATE_IN_VENV")
            and os.path.realpath(sys.prefix) != os.path.realpath(os.path.dirname(os.path.dirname(VENV_PY)))):
        os.environ["HAMPI_TRANSLATE_IN_VENV"] = "1"
        os.execv(VENV_PY, [VENV_PY, os.path.abspath(__file__)] + argv)

    p = argparse.ArgumentParser(prog="hampi-translate", description=__doc__.split("\n\n")[0])
    p.add_argument("--conf", help="config file (default /etc/hampi/translate.conf)")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("check", help="verify models, audio devices and PTT")
    r = sub.add_parser("run", help="operate the translator")
    r.add_argument("--no-tx", action="store_true",
                   help="practice mode: never key the radio, play to headphones")
    for name, help_ in (("text", "translate typed text"), ("file", "translate a WAV recording")):
        s = sub.add_parser(name, help=help_)
        s.add_argument("text" if name == "text" else "wav")
        s.add_argument("--rx", action="store_true", help="their language -> mine")
        s.add_argument("--from", dest="src", help="source language code (default MY_LANG)")
        s.add_argument("--to", dest="dst", help="target language code (default THEIR_LANG)")
        s.add_argument("--out", help="write the spoken translation to this WAV")
        if name == "text":
            s.add_argument("--speak", action="store_true", help="play it on OPERATOR_OUT")
    b = sub.add_parser("bench", help="time each stage on this board")
    b.add_argument("wav", nargs="?", help="WAV of you talking, e.g. a 10 s over (default: synthetic)")
    b.add_argument("--runs", type=int, default=3, help="timed runs (default 3)")
    sub.add_parser("devices", help="list audio devices")
    f = sub.add_parser("fetch-packs", help="download translation packs (needs internet once)")
    f.add_argument("--langs", nargs="+", help="partner languages (default THEIR_LANG)")
    args = p.parse_args(argv)
    conf = load_conf(args.conf)
    handler = {"check": cmd_check, "run": cmd_run, "text": cmd_text, "file": cmd_file,
               "bench": cmd_bench, "devices": cmd_devices, "fetch-packs": cmd_fetch}[args.cmd]
    try:
        return handler(conf, args) or 0
    except (RuntimeError, OSError) as exc:      # OSError covers network/device failures
        sys.exit(f"error: {exc}")
    except ImportError as exc:
        sys.exit(f"error: {exc}. Run: sudo rfpi-translator-install")
    except ValueError as exc:
        sys.exit(f"error: bad value in {args.conf or CONF_PATH}: {exc}")


if __name__ == "__main__":
    sys.exit(main())
