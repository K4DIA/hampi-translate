        src, dst = dst, src
    return args.src or src, args.dst or dst


class _NoSTT:
    def transcribe(self, audio, lang):
        raise RuntimeError("speech-to-text not needed for this command")


def _board():
    try:
        with open("/proc/device-tree/model") as fh:
            return fh.read().strip("\x00\n")
    except OSError:
        return "unknown board"


def _cpu_temp():
    try:
        with open("/sys/class/thermal/thermal_zone0/temp") as fh:
            return f"{int(fh.read()) / 1000:.0f} °C"
    except (OSError, ValueError):
        return "n/a"


def _throttled():
    try:
        out = subprocess.run(["vcgencmd", "get_throttled"], capture_output=True, text=True,
                             timeout=3).stdout.strip()
        return out.split("=")[-1] or "n/a"
    except (OSError, subprocess.SubprocessError):
        return "n/a"


def cmd_bench(conf, args):
    my, their = conf["MY_LANG"], conf["THEIR_LANG"]
    engine = Engine(conf)
    runs = max(1, args.runs)
    sentence = ("Good morning, this is a test of the offline translator. "
                "Your signal is five nine and my QTH is the shack.")
    if args.wav:
        audio, rate = read_wav(args.wav)
        audio = resample(audio, rate, STT_RATE)
    else:
        a, rate = engine.tts.synth(sentence, my)
        audio = resample(a, rate, STT_RATE)
    secs = len(audio) / STT_RATE
    print(f"{_board()}  ·  CPU {_cpu_temp()}  ·  throttled={_throttled()}")
    print(f"Test audio: {secs:.1f} s of speech, {runs} timed run(s) after one warm-up\n")
    engine.translate_audio(audio, my, their, speak=True)            # warm-up
    times = {"stt": [], "translate": [], "tts": []}
    r = None
    for _ in range(runs):
        r = engine.translate_audio(audio, my, their, speak=True)
        for k in times:
            times[k].append(r.timings.get(k, 0.0))
    print(f"{'stage':<12}{'median':>8}{'x real time':>14}")
    total = 0.0
    for k, v in times.items():
        m = statistics.median(v)
        total += m
        print(f"{k:<12}{m:>7.2f}s{m / secs:>13.2f}x")
    print(f"{'dead air':<12}{total:>7.2f}s   (release -> key-up, excluding PTT lead)")
    if r and r.translation:
        print(f"\nHeard:      {r.heard}\nTranslated: {r.translation.display}")
    print(f"\nCPU after: {_cpu_temp()}  ·  throttled={_throttled()} (0x0 = never throttled)")
    print("Power: read a USB-C inline meter during the runs; the Pi can't measure its own draw.")


