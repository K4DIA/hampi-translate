# The translator itself
# ---------------------------------------------------------------------------

@dataclass
class Result:
    heard: str = ""
    lang: str = ""
    translation: Translation = None
    audio: object = None
    rate: int = 0
    timings: dict = field(default_factory=dict)


class Engine:
    """STT -> jargon-safe translation -> TTS. Components are injectable so the
    whole chain can be tested without models or sound hardware."""

    def __init__(self, conf, stt=None, translator=None, tts=None):
        self.conf = conf
        self.stt = stt or make_stt(conf)
        self.translator = translator or PhraseTranslator(
            PackBackend(conf.get("ARGOS_DIR", ARGOS_DIR), conf.get("TRANSLATE_BEAM", 2),
                        conf.get("WHISPER_THREADS", 4)),
            load_glossary(conf.get("GLOSSARY", "")))
        self.tts = tts or make_tts(conf)

    def translate_audio(self, audio16k, src, dst, speak=True, disclose=False):
        r = Result()
        t = time.monotonic()
        r.heard, r.lang = self.stt.transcribe(audio16k, whisper_code(src))
        r.lang = lang_code(r.lang) or r.lang
        r.timings["stt"] = time.monotonic() - t
        if not r.heard:
            return r
        src = r.lang if src in ("", "auto") else src
        self._finish(r, r.heard, src, dst, speak, disclose)
        return r

    def translate_text(self, text, src, dst, speak=True, disclose=False):
        r = Result(heard=text, lang=src)
        self._finish(r, text, src, dst, speak, disclose)
        return r

    def _finish(self, r, text, src, dst, speak, disclose):
        t = time.monotonic()
        r.translation = self.translator.translate(text, src, dst)
        r.timings["translate"] = time.monotonic() - t
        if speak:
            t = time.monotonic()
            spoken = r.translation.spoken
            if disclose and dst in DISCLOSURE:
                spoken = f"{DISCLOSURE[dst]} {spoken}"
            r.audio, r.rate = self.tts.synth(spoken, dst)
            r.timings["tts"] = time.monotonic() - t

    def id_audio(self):
        call = self.conf["CALLSIGN"]
        if self.conf.get("ID_WAV") and os.path.exists(self.conf["ID_WAV"]):
            return read_wav(self.conf["ID_WAV"])
        return self.tts.synth(f"This is {phonetic(call)}.", "en")


class Status:
    """Small JSON file other RF Pi tools (e.g. a dashboard widget) can read."""

    def __init__(self, path):
        self.path = path
        self.data = {"state": "starting", "log": []}
        self._lock = threading.Lock()       # written from the TX and RX threads

    def set(self, state=None, **kw):
        """Set the state (None keeps it) and write the file."""
        with self._lock:
            if state is not None:
                self.data["state"] = state
                if state != "review":
                    self.data.pop("pending", None)
            self.data.update(kw)
            self.data["updated"] = time.time()
            if not self.path:
                return
            try:
                tmp = self.path + ".tmp"
                with open(tmp, "w") as fh:
                    json.dump(self.data, fh)
                os.replace(tmp, self.path)
            except OSError:
                pass

    def log(self, direction, original, translated):
        with self._lock:
            self.data["log"] = (self.data["log"] + [{"t": time.time(), "dir": direction,
                                                     "heard": original,
                                                     "text": translated}])[-30:]
        self.set()


def _fmt_t(t):
    return "  ".join(f"{k} {v:.1f}s" for k, v in t.items())


def _callsign_ok(call):
    return bool(CALL_RE.fullmatch(call or "")) and call.upper() != "N0CALL"


def cmd_run(conf, args):
    my, their = conf["MY_LANG"], conf["THEIR_LANG"]
    rx_lang = conf["RX_LANG"] or their
    no_tx = args.no_tx
    if not no_tx and not _callsign_ok(conf["CALLSIGN"]):
        sys.exit("Set CALLSIGN in /etc/hampi/station.conf before transmitting "
                 "(or use --no-tx to practise).")
    engine = Engine(conf)
    status = Status(conf.get("STATUS_FILE"))
    op_in = find_device(conf["OPERATOR_IN"], "input")
    op_out = find_device(conf["OPERATOR_OUT"], "output")
    radio_out = op_out if no_tx else find_device(conf["RADIO_OUT"], "output")
    ptt = NullPTT() if no_tx else make_ptt(conf)
    local = make_local(conf)
    ids = IdTimer(int(conf["ID_EVERY_MIN"]))
    muted = threading.Event()
    cpu = threading.Lock()          # one translation at a time: a Pi 4 has 4 cores, not 8

    print(f"RF Pi translator  {my} -> {their} on transmit, {rx_lang} -> {my} on receive")
    print(f"Station {conf['CALLSIGN']}  PTT: {'(practice, radio not keyed)' if no_tx else ptt.name}")
    print("Loading models...")
    t = time.monotonic()
    engine.translate_text("Good morning.", my, their, speak=True)
    engine.translate_text("Buongiorno." if their == "it" else "Hello.", their, my, speak=False)
    print(f"Ready ({time.monotonic() - t:.1f} s warm-up).")
    status.set("idle")

    if flag(conf, "RX") and not no_tx:
        threading.Thread(target=_rx_loop, args=(conf, engine, status, muted, cpu, rx_lang,
                                                my, op_out), daemon=True).start()

    def send_id():
        _transmit(conf, ptt, radio_out, muted, [], status, id_part=engine.id_audio())
        ids.mark()
        print(f"ID sent: {conf['CALLSIGN']}")

    def one_over():
        status.set("recording")
        audio = record_while(op_in, local.is_down, float(conf["MAX_RECORD_SEC"]))
        local.end_talk()
        released = time.monotonic()
        if len(audio) < STT_RATE * 0.4:
            print("(too short, ignored)")
            return
        status.set("processing")
        with cpu:
            r = engine.translate_audio(audio, my, their, speak=True,
                                       disclose=flag(conf, "DISCLOSE"))
        if not r.heard:
            print("(no speech recognised)")
            return
        print(f"\nYou said : {r.heard}")
        print(f"Sending  : {r.translation.display}"
              + ("   [jargon spliced: check it]" if r.translation.fallback else ""))
        print(f"           ({_fmt_t(r.timings)})")
        status.log("tx", r.heard, r.translation.display)
        if flag(conf, "REVIEW"):
            status.set("review", pending=r.translation.display)
            if not local.confirm(float(conf["REVIEW_TIMEOUT"])):
                print("Discarded, nothing sent.")
                return
        # Decide on the ID after the review wait, counting this over's length.
        with_id = ids.due(len(r.audio) / r.rate + 5)
        dead_air = time.monotonic() - released
        _transmit(conf, ptt, radio_out, muted, [(r.audio, r.rate)], status,
                  id_part=engine.id_audio() if with_id else None)
        ids.note_tx()
        if with_id:
            ids.mark()
        if not flag(conf, "REVIEW"):
            print(f"Dead air before key-up: {dead_air:.1f} s")

    # A dropped SSH session (SIGHUP) or `kill` (SIGTERM) must unkey too: turn
    # them into a normal exit so the finally blocks run.
    def on_signal(signum, _frame):
        raise SystemExit(f"stopped by signal {signum}")
    old_handlers = {}
    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            old_handlers[sig] = signal.signal(sig, on_signal)
        except (ValueError, OSError):       # not the main thread
            pass

    try:
        while True:
            cmd = local.wait_press()
            try:
                if cmd == "quit":
                    # 97.119: ID at the end of the contact. Still needs a press.
                    if (ids.since_id and not no_tx
                            and local.confirm(float(conf["REVIEW_TIMEOUT"]),
                                              f"Send your ID ({conf['CALLSIGN']}) to end "
                                              "the contact?")):
                        send_id()
                    break
                if cmd == "id":
                    send_id()
                else:
                    one_over()
            except Exception as exc:  # noqa: BLE001 - one bad over must not end the QSO
                print(f"\n!! {type(exc).__name__}: {exc}\n   Nothing more was sent. "
                      "Try that over again.", file=sys.stderr)
            status.set("idle")
    except KeyboardInterrupt:
        pass
    finally:
        try:
            ptt.key(False)          # belt and braces: never leave the rig keyed
            ptt.close()
        except Exception as exc:  # noqa: BLE001
            print(f"!! Could not confirm unkey via {ptt.name}: {exc} -- check the radio",
                  file=sys.stderr)
        status.set("stopped")
        for sig, handler in old_handlers.items():
            signal.signal(sig, handler)
        if ids.since_id and not no_tx:
            print(f"Reminder: you have not identified since your last transmission. Give "
                  f"your callsign ({conf['CALLSIGN']}) on the rig mic to end the contact "
                  "(97.119).")


def _transmit(conf, ptt, dev, muted, parts, status, id_part=None):
    """Play the (audio, rate) parts, then the station ID if given, with the
    radio keyed once. The message is trimmed to fit MAX_TX_SEC; the ID never is."""
    rate = 22050
    lead, tail = int(conf["PTT_LEAD_MS"]), int(conf["PTT_TAIL_MS"])
    cap = float(conf["MAX_TX_SEC"])
    ident = resample(*id_part, rate) if id_part else None
    audio = join_audio([resample(a, r, rate) for a, r in parts], rate)
    room = cap - (len(ident) / rate + 0.25 if ident is not None else 0)
    if len(audio) > room * rate:
        print(f"(message cut to fit the {cap:.0f} s MAX_TX_SEC limit)")
        audio = audio[:max(0, int(room * rate))]
    audio = join_audio([audio, ident], rate)
    muted.set()
    status.set("transmitting")
    try:
        # The watchdog bounds keyed time even if the sound device stalls.
        with keyed(ptt, lead, tail, max_s=len(audio) / rate + (lead + tail) / 1000 + 5):
            play(audio, rate, dev, gain=float(conf["RADIO_GAIN"]))
    finally:
        time.sleep(0.3)             # let the rig's own receive recovery pass
        muted.clear()


def _rx_loop(conf, engine, status, muted, cpu, rx_lang, my, op_out):
    try:
        _rx_listen(conf, engine, status, muted, cpu, rx_lang, my, op_out)
    except BaseException as exc:  # noqa: BLE001 - say so; don't die silently
        print(f"\n!! Receive translation stopped: {exc}\n   Transmit still works. "
              "Check RADIO_IN (hampi-translate devices).", file=sys.stderr)


def _rx_listen(conf, engine, status, muted, cpu, rx_lang, my, op_out):
    sd = _sd()
    dev = find_device(conf["RADIO_IN"], "input")
    rate = device_rate(dev, "input")
    seg = Segmenter(rate, float(conf["RX_THRESHOLD_DB"]), int(conf["RX_HANG_MS"]),
                    int(conf["RX_MIN_MS"]))
    blocks = queue.Queue()

    def capture(data, *_):
        if not muted.is_set():          # drop our own transmission at the source
            blocks.put(data[:, 0].copy())

    with sd.InputStream(device=dev, channels=1, samplerate=rate, dtype="float32",
                        blocksize=int(rate * 0.05), callback=capture):
        while True:
            block = blocks.get()
            if muted.is_set():
                seg.reset()
                continue
            for s in seg.feed(block):
                try:
                    with cpu:
                        r = engine.translate_audio(resample(s, rate, STT_RATE),
                                                   "" if rx_lang == "auto" else rx_lang, my,
                                                   speak=True)
                    if not r.heard:
                        continue
                    print(f"\n◀ Heard   : {r.heard}  [{r.lang}]")
                    print(f"◀ Meaning : {r.translation.display}   ({_fmt_t(r.timings)})")
                    status.log("rx", r.heard, r.translation.display)
                    # Text is on screen either way; don't talk over a transmission.
                    play(r.audio, r.rate, op_out, stop=muted)
                except Exception as exc:  # noqa: BLE001 - keep listening
                    print(f"\n◀ (receive error, still listening: {exc})", file=sys.stderr)


