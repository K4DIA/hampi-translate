class NullPTT:
    name = "none"

    def key(self, on):
        pass

    def close(self):
        pass


class RigctldPTT:
    """Hamlib's rigctld (already part of RF Pi): 'T 1' keys, 'T 0' unkeys."""
    name = "rigctld"

    def __init__(self, hostport, timeout=3):
        host, _, port = hostport.rpartition(":")
        self.addr = (host or "127.0.0.1", int(port or 4532))
        self.timeout = timeout

    def _cmd(self, line):
        with socket.create_connection(self.addr, timeout=self.timeout) as s:
            s.sendall((line + "\n").encode())
            reply = s.recv(256).decode(errors="replace").strip()
        return reply

    def key(self, on):
        reply = self._cmd(f"T {1 if on else 0}")
        if not reply.startswith("RPRT 0"):
            raise RuntimeError(f"rigctld refused PTT: {reply or 'no reply'}")

    def status(self):
        return self._cmd("t")

    def close(self):
        pass


class SerialPTT:
    """RTS or DTR on a serial port (Digirig, most CAT/USB cables)."""

    def __init__(self, port, line="rts"):
        import serial
        self.name = line
        self.line = line
        # Set both lines low BEFORE opening: a plain Serial(port) raises RTS
        # and DTR as it opens, which would key the rig at start-up.
        self.ser = serial.Serial()
        self.ser.port = port
        self.ser.rts = False
        self.ser.dtr = False
        self.ser.open()

    def key(self, on):
        setattr(self.ser, self.line, bool(on))

    def close(self):
        self.key(False)
        self.ser.close()


class GpioPTT:
    name = "gpio"

    def __init__(self, pin):
        from gpiozero import OutputDevice
        self.dev = OutputDevice(int(pin), active_high=True, initial_value=False)

    def key(self, on):
        self.dev.value = bool(on)

    def close(self):
        self.dev.off()
        self.dev.close()


def make_ptt(conf):
    kind = conf["PTT"].lower()
    if kind == "rigctld":
        return RigctldPTT(conf["RIGCTLD"])
    if kind in ("rts", "dtr"):
        return SerialPTT(conf["PTT_SERIAL"], kind)
    if kind == "gpio":
        return GpioPTT(conf["PTT_GPIO"])
    return NullPTT()          # vox / none: the rig keys itself from the audio


@contextmanager
def keyed(ptt, lead_ms=300, tail_ms=200, max_s=None):
    """Key the radio for the duration of the block. Always unkeys, even on
    error or Ctrl-C. With max_s, a watchdog also unkeys after that many
    seconds if the block is still running (a stalled sound device must not
    hold the transmitter on)."""
    def force_off():
        print(f"\n!! Transmission exceeded {max_s:.0f} s: unkeying.", file=sys.stderr)
        try:
            ptt.key(False)
        except Exception as exc:  # noqa: BLE001
            print(f"!! FAILED TO UNKEY via {ptt.name}: {exc} -- unkey the radio by hand",
                  file=sys.stderr)

    watchdog = threading.Timer(max_s, force_off) if max_s else None
    if watchdog:
        watchdog.daemon = True
        watchdog.start()
    try:
        ptt.key(True)
        time.sleep(lead_ms / 1000)
        yield
        time.sleep(tail_ms / 1000)
    finally:
        if watchdog:
            watchdog.cancel()
        try:
            ptt.key(False)
        except Exception as exc:  # noqa: BLE001
            print(f"!! FAILED TO UNKEY via {ptt.name}: {exc} -- unkey the radio by hand",
                  file=sys.stderr)
            raise


