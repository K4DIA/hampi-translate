class PiperTTS:
    def __init__(self, piper, voices):
        self.piper = piper
        self.voices = voices        # lang -> .onnx path

    def synth(self, text, lang):
        model = self.voices.get(lang)
        if not model:
            raise RuntimeError(f"No Piper voice configured for '{lang}' (set VOICE_{lang.upper()}).")
        with tempfile.TemporaryDirectory() as d:
            out = os.path.join(d, "say.wav")
            # One line = one utterance; keep it to one so it lands in one WAV.
            line = re.sub(r"\s+", " ", text).strip() + "\n"
            run_tool([self.piper, "-m", model, "-f", out], input=line.encode("utf-8"))
            return read_wav(out)


class OpenJTalkTTS:
    """Open JTalk: the offline Japanese voice (Piper has no Japanese voice).
    Debian packages: open-jtalk, open-jtalk-mecab-naist-jdic, hts-voice-*."""

    def __init__(self, voice, dic, binary="open_jtalk"):
        self.voice, self.dic, self.binary = voice, dic, binary

    def synth(self, text, lang):
        with tempfile.TemporaryDirectory() as d:
            src, out = os.path.join(d, "say.txt"), os.path.join(d, "say.wav")
            with open(src, "w", encoding="utf-8") as fh:
                fh.write(re.sub(r"\s+", " ", text).strip() + "\n")
            run_tool([self.binary, "-x", self.dic, "-m", self.voice, "-ow", out, src])
            return read_wav(out)


OPENJTALK = "openjtalk:"        # VOICE_JA=openjtalk:/path/to/voice.htsvoice


class VoiceBank:
    """Picks the engine per language: Piper .onnx voices, or Open JTalk."""

    def __init__(self, piper, voices, dic=""):
        self.piper, self.voices, self.dic = piper, voices, dic

    def synth(self, text, lang):
        v = self.voices.get(lang)
        if not v:
            raise RuntimeError(f"No voice configured for '{lang}' (set VOICE_{lang.upper()}).")
        if v.startswith(OPENJTALK):
            return OpenJTalkTTS(v[len(OPENJTALK):], self.dic).synth(text, lang)
        return PiperTTS(self.piper, {lang: v}).synth(text, lang)


def make_tts(conf):
    voices = {k[6:].lower(): v for k, v in conf.items() if k.startswith("VOICE_") and v}
    return VoiceBank(conf["PIPER"], voices, conf.get("OPENJTALK_DIC", ""))


