# whisper-server reports detected languages by full name ("italian").
WHISPER_NAMES = {name.lower(): code for code, (name, *_rest) in LANGUAGES.items()}
WHISPER_NAMES.update({"persian": "fa", "norwegian": "nb", "korean": "ko"})


def lang_code(name):
    """Whisper's language name or code -> the Argos code this tool uses."""
    name = (name or "").strip().lower()
    if len(name) == 2:
        return FROM_WHISPER.get(name, name)
    return WHISPER_NAMES.get(name, "")


def _multipart(fields, files):
    boundary = uuid.uuid4().hex
    out = io.BytesIO()
    for k, v in fields.items():
        out.write(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n"
                  f"{v}\r\n".encode())
    for k, (fname, data, ctype) in files.items():
        out.write(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"; "
                  f"filename=\"{fname}\"\r\nContent-Type: {ctype}\r\n\r\n".encode())
        out.write(data)
        out.write(b"\r\n")
    out.write(f"--{boundary}--\r\n".encode())
    return out.getvalue(), f"multipart/form-data; boundary={boundary}"


class WhisperServerSTT:
    """whisper.cpp's whisper-server on localhost keeps the model in RAM, so
    each transmission skips the 1-2 s model load a Pi 4 would otherwise pay."""

    def __init__(self, url, timeout=180):
        self.url = url.rstrip("/") + "/inference"
        self.timeout = timeout

    def transcribe(self, audio16k, lang):
        import urllib.request
        auto = lang in ("", "auto", None)
        # Plain "json" when the language is known: "verbose_json" makes the
        # server run a second, expensive language-detection pass.
        fields = {"response_format": "verbose_json" if auto else "json",
                  "temperature": "0.0", "best_of": "1", "language": "auto" if auto else lang}
        body, ctype = _multipart(fields, {"file": ("tx.wav", wav_bytes(audio16k, STT_RATE),
                                                   "audio/wav")})
        req = urllib.request.Request(self.url, data=body, headers={"Content-Type": ctype})
        with urllib.request.urlopen(req, timeout=self.timeout) as resp:
            data = json.loads(resp.read().decode("utf-8", "replace"))
        if "error" in data:
            raise RuntimeError(f"whisper-server: {data['error']}")
        detected = lang_code(data.get("language", "")) if auto else lang
        return clean_transcript(data.get("text", "")), detected or lang


class WhisperCliSTT:
    """Fallback: run whisper-cli per transmission (reloads the model each time)."""

    def __init__(self, cli, model, threads=4):
        self.cli, self.model, self.threads = cli, model, str(threads)

    def transcribe(self, audio16k, lang):
        with tempfile.TemporaryDirectory() as d:
            wav = os.path.join(d, "tx.wav")
            write_wav(wav, audio16k, STT_RATE)
            base = os.path.join(d, "out")
            run_tool([self.cli, "-m", self.model, "-f", wav, "-l", lang or "auto",
                      "-t", self.threads, "-bs", "1", "-bo", "1", "-np", "-nt",
                      "-oj", "-of", base])
            with open(base + ".json", encoding="utf-8") as fh:
                data = json.load(fh)
        text = " ".join(s.get("text", "") for s in data.get("transcription", []))
        detected = (data.get("result") or {}).get("language") or lang
        return clean_transcript(text), detected


def make_stt(conf):
    if conf["STT"] == "cli":
        return WhisperCliSTT(conf["WHISPER_CLI"], conf["WHISPER_MODEL"], conf["WHISPER_THREADS"])
    return WhisperServerSTT(conf["WHISPER_URL"])


