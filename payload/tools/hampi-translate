# Station identification (FCC 97.119: English, at the end of each contact
# and at least every 10 minutes during it)
# ---------------------------------------------------------------------------

class IdTimer:
    def __init__(self, every_min=10, margin_s=15, clock=time.monotonic):
        self.every = every_min * 60
        self.margin = margin_s
        self.clock = clock
        self.last = None            # last ID sent
        self.since_id = False       # transmitted since the last ID?

    def note_tx(self):
        self.since_id = True

    def due(self, duration=0.0):
        """Should a transmission lasting `duration` seconds end with an ID?
        True on the first one, and whenever it would otherwise finish past
        the 10-minute mark (the ID goes at the end of the over)."""
        if self.last is None:
            return True
        return self.clock() - self.last + duration >= self.every - self.margin

    def mark(self):
        self.last = self.clock()
        self.since_id = False


